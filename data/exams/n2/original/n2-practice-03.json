    {
      "id": "section-2",
      "title": "文法",
      "items": [
        { "id": 33, "mondai": 7, "type": "GRAMMAR", "question": "遠くからもよく見える（ ）、字を大きく書いてください。", "choices": [{ "id": 1, "text": "ように" }, { "id": 2, "text": "ために" }, { "id": 3, "text": "だけに" }, { "id": 4, "text": "ばかりに" }], "correctAnswer": 1, "explanation": null, "needsReview": false },
        { "id": 34, "mondai": 7, "type": "GRAMMAR", "question": "行きたくない（ ）はないんですが、今日は、時間がないんです。", "choices": [{ "id": 1, "text": "ほう" }, { "id": 2, "text": "もの" }, { "id": 3, "text": "よう" }, { "id": 4, "text": "こと" }], "correctAnswer": 4, "explanation": null, "needsReview": false },
        { "id": 35, "mondai": 7, "type": "GRAMMAR", "question": "先生が丁寧にご説明（ ）ので、私もよく分かりました。", "choices": [{ "id": 1, "text": "いただいた" }, { "id": 2, "text": "くださった" }, { "id": 3, "text": "いたした" }, { "id": 4, "text": "さしあげた" }], "correctAnswer": 2, "explanation": null, "needsReview": false },
        { "id": 36, "mondai": 7, "type": "GRAMMAR", "question": "自分の傘は人に貸してしまった（ ）、私はしかたなく、ぬれて帰った。", "choices": [{ "id": 1, "text": "だけあって" }, { "id": 2, "text": "ため" }, { "id": 3, "text": "のだから" }, { "id": 4, "text": "からして" }], "correctAnswer": 2, "explanation": null, "needsReview": false },
        { "id": 37, "mondai": 7, "type": "GRAMMAR", "question": "不思議な（ ）、会社を辞めたら、よく眠れるようになった。", "choices": [{ "id": 1, "text": "ことに" }, { "id": 2, "text": "せいで" }, { "id": 3, "text": "ものから" }, { "id": 4, "text": "ばかりに" }], "correctAnswer": 1, "explanation": null, "needsReview": false },
        { "id": 38, "mondai": 7, "type": "GRAMMAR", "question": "この本を読む（ ）、彼のことを思い出す。", "choices": [{ "id": 1, "text": "とおりに" }, { "id": 2, "text": "たびに" }, { "id": 3, "text": "からして" }, { "id": 4, "text": "ように" }], "correctAnswer": 2, "explanation": null, "needsReview": false },
        { "id": 39, "mondai": 7, "type": "GRAMMAR", "question": "毎年カエルの声を聞くころになると、ふるさとを思い出さずには（ ）。", "choices": [{ "id": 1, "text": "いられない" }, { "id": 2, "text": "なりえない" }, { "id": 3, "text": "おわらない" }, { "id": 4, "text": "とまらない" }], "correctAnswer": 1, "explanation": null, "needsReview": false },
        { "id": 40, "mondai": 7, "type": "GRAMMAR", "question": "弟は、酒が飲めない（ ）ぜんぜん飲めないわけではない。", "choices": [{ "id": 1, "text": "としたら" }, { "id": 2, "text": "どころか" }, { "id": 3, "text": "といっても" }, { "id": 4, "text": "というより" }], "correctAnswer": 3, "explanation": null, "needsReview": false },
        { "id": 41, "mondai": 7, "type": "GRAMMAR", "question": "雑誌に店の名前が出た（ ）、客がたくさん来るようになった。", "choices": [{ "id": 1, "text": "くせに" }, { "id": 2, "text": "おかげで" }, { "id": 3, "text": "うえで" }, { "id": 4, "text": "ためで" }], "correctAnswer": 2, "explanation": null, "needsReview": false },
        { "id": 42, "mondai": 7, "type": "GRAMMAR", "question": "子供（ ）知っているようなことを大人の私が知らなかったのは恥ずかしい。", "choices": [{ "id": 1, "text": "なら" }, { "id": 2, "text": "だから" }, { "id": 3, "text": "だけが" }, { "id": 4, "text": "でさえ" }], "correctAnswer": 4, "explanation": null, "needsReview": false },
        { "id": 43, "mondai": 7, "type": "GRAMMAR", "question": "この文章は漢字の間違いが多い（ ）文法の間違いも多いので、何が言いたいのかよく分からない。", "choices": [{ "id": 1, "text": "うえに" }, { "id": 2, "text": "ものの" }, { "id": 3, "text": "わりに" }, { "id": 4, "text": "うちに" }], "correctAnswer": 1, "explanation": null, "needsReview": false },
        { "id": 44, "mondai": 7, "type": "GRAMMAR", "question": "あそこにいる人、昨日会社に来た人（ ）気がするけど……。", "choices": [{ "id": 1, "text": "らしく" }, { "id": 2, "text": "みたいで" }, { "id": 3, "text": "そうな" }, { "id": 4, "text": "のような" }], "correctAnswer": 4, "explanation": null, "needsReview": false },
        { "id": 45, "mondai": 8, "type": "SENTENCE_ORDER", "sentenceBefore": "人が本を", "sentenceAfter": "、書評、人の噂、インターネットの情報とさまざまだ。", "fragments": [{ "id": 1, "text": "きっかけは" }, { "id": 2, "text": "広告" }, { "id": 3, "text": "とる" }, { "id": 4, "text": "手に" }], "correctOrder": [4, 3, 1, 2], "starPosition": 3, "correctAnswer": 1, "explanation": null, "needsReview": false },
        { "id": 46, "mondai": 8, "type": "SENTENCE_ORDER", "sentenceBefore": "あなたの説明のおかげで", "sentenceAfter": "よくわかりました。", "fragments": [{ "id": 1, "text": "わけではない" }, { "id": 2, "text": "ことは" }, { "id": 3, "text": "悪気があった" }, { "id": 4, "text": "彼女に" }], "correctOrder": [4, 3, 1, 2], "starPosition": 3, "correctAnswer": 1, "explanation": null, "needsReview": false },
        { "id": 47, "mondai": 8, "type": "SENTENCE_ORDER", "sentenceBefore": "その湖から見た", "sentenceAfter": "だった。", "fragments": [{ "id": 1, "text": "光景" }, { "id": 2, "text": "山は" }, { "id": 3, "text": "ほど美しい" }, { "id": 4, "text": "言いようがない" }], "correctOrder": [2, 4, 3, 1], "starPosition": 3, "correctAnswer": 3, "explanation": null, "needsReview": false },
        { "id": 48, "mondai": 8, "type": "SENTENCE_ORDER", "sentenceBefore": "テーブルの上にある携帯電話は", "sentenceAfter": "ものです。", "fragments": [{ "id": 1, "text": "女の人の" }, { "id": 2, "text": "うしろに" }, { "id": 3, "text": "私のすぐ" }, { "id": 4, "text": "座っている" }], "correctOrder": [3, 2, 4, 1], "starPosition": 3, "correctAnswer": 4, "explanation": null, "needsReview": false },
        { "id": 49, "mondai": 8, "type": "SENTENCE_ORDER", "sentenceBefore": "どうして", "sentenceAfter": "いますか。", "fragments": [{ "id": 1, "text": "だれか" }, { "id": 2, "text": "欠席しているのか" }, { "id": 3, "text": "聞いて" }, { "id": 4, "text": "田中君が" }], "correctOrder": [4, 2, 1, 3], "starPosition": 3, "correctAnswer": 1, "explanation": null, "needsReview": false },
        {
          "id": "cloze-09-01",
          "type": "CLOZE",
          "passageId": "cloze-09-01",
          "passage": "最近よく頭痛がする。大したことはないのだが、妻が心配してうるさいので、すすめられるままに近所の病院に行ってみた。（50）、特に異常はないとのことだった。しかし確かに痛い。異常はないと言われた（51）、逆に心配になってきた。痛みが次第に強くなり、回数も増えてきたような気がする。こんなに痛いのにどこも悪くない（52）。もしかすると、原因不明の重い病気なのではないだろうか。\n\n悩んだ（53）、大きな病院の神経内科を受診してみた。その結果、原因は目の疲れだということだった。考えてみると、朝から晩まで仕事でパソコンに（54）。なんだ、そんなことか。そう思っただけで、薬も飲まないのに痛みが引いていくようだった。",
          "needsReview": false,
          "questions": [
