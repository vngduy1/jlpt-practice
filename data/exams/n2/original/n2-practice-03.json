      "items": [
        { "id": 1, "mondai": 1, "type": "KANJI_READING", "question": "額にびっしょり、汗をかいた。", "target": "額", "choices": [{ "id": 1, "text": "わき" }, { "id": 2, "text": "かお" }, { "id": 3, "text": "あたま" }, { "id": 4, "text": "ひたい" }], "correctAnswer": 4, "explanation": null, "needsReview": false },
        { "id": 2, "mondai": 1, "type": "KANJI_READING", "question": "父親に怒られて、その子は元気がなかった。", "target": "怒られて", "choices": [{ "id": 1, "text": "しかられ" }, { "id": 2, "text": "おこられ" }, { "id": 3, "text": "どなられ" }, { "id": 4, "text": "うあらぎられ" }], "correctAnswer": 2, "explanation": null, "needsReview": true },
        { "id": 3, "mondai": 1, "type": "KANJI_READING", "question": "この問題は思ったよりも難しい。", "target": "難しい", "choices": [{ "id": 1, "text": "きびしい" }, { "id": 2, "text": "むずかしい" }, { "id": 3, "text": "おそろしい" }, { "id": 4, "text": "やさしい" }], "correctAnswer": 2, "explanation": null, "needsReview": false },
        { "id": 4, "mondai": 1, "type": "KANJI_READING", "question": "受付から、迷子のお知らせです。", "target": "迷子", "choices": [{ "id": 1, "text": "めいご" }, { "id": 2, "text": "めいこ" }, { "id": 3, "text": "まいご" }, { "id": 4, "text": "まいこ" }], "correctAnswer": 3, "explanation": null, "needsReview": false },
        { "id": 5, "mondai": 1, "type": "KANJI_READING", "question": "私が山で経験したことは、恐怖そのものだった。", "target": "恐怖", "choices": [{ "id": 1, "text": "きょうふ" }, { "id": 2, "text": "きょふ" }, { "id": 3, "text": "こうふ" }, { "id": 4, "text": "こふ" }], "correctAnswer": 1, "explanation": null, "needsReview": false },
        { "id": 6, "mondai": 2, "type": "VOCABULARY", "question": "あの会社の社長は、うちの社員に対してむりばかり言う。", "target": "むり", "choices": [{ "id": 1, "text": "無里" }, { "id": 2, "text": "無理" }, { "id": 3, "text": "夢中" }, { "id": 4, "text": "夢利" }], "correctAnswer": 2, "explanation": null, "needsReview": false },
        { "id": 7, "mondai": 2, "type": "VOCABULARY", "question": "彼女は今、せいしん的にかなり弱っている。", "target": "せいしん", "choices": [{ "id": 1, "text": "精神" }, { "id": 2, "text": "精心" }, { "id": 3, "text": "性心" }, { "id": 4, "text": "性神" }], "correctAnswer": 1, "explanation": null, "needsReview": false },
        { "id": 8, "mondai": 2, "type": "VOCABULARY", "question": "長い間の努力が、やっと実をむすんだ。", "target": "むすんだ", "choices": [{ "id": 1, "text": "果んだ" }, { "id": 2, "text": "産んだ" }, { "id": 3, "text": "結んだ" }, { "id": 4, "text": "咲んだ" }], "correctAnswer": 3, "explanation": null, "needsReview": false },
        { "id": 9, "mondai": 2, "type": "VOCABULARY", "question": "少し、頭がこんらんしてきたので、話を整理しましょう。", "target": "こんらん", "choices": [{ "id": 1, "text": "混乱" }, { "id": 2, "text": "困惑" }, { "id": 3, "text": "混浴" }, { "id": 4, "text": "困難" }], "correctAnswer": 1, "explanation": null, "needsReview": false },
        { "id": 10, "mondai": 2, "type": "VOCABULARY", "question": "日本人は、よくきんべんだと言われる。", "target": "きんべん", "choices": [{ "id": 1, "text": "勤便" }, { "id": 2, "text": "緊勉" }, { "id": 3, "text": "金便" }, { "id": 4, "text": "勤勉" }], "correctAnswer": 4, "explanation": null, "needsReview": false },
        { "id": 11, "mondai": 3, "type": "VOCABULARY", "question": "昨日の帰り、知らない男に追い（ ）て、怖い思いをした。", "choices": [{ "id": 1, "text": "はらわれ" }, { "id": 2, "text": "おそわれ" }, { "id": 3, "text": "かけられ" }, { "id": 4, "text": "さわがれ" }], "correctAnswer": 3, "explanation": null, "needsReview": false },
        { "id": 12, "mondai": 3, "type": "VOCABULARY", "question": "この時期になると、5時をすぎると、外はもう（ ）暗だ。", "choices": [{ "id": 1, "text": "真っ" }, { "id": 2, "text": "全っ" }, { "id": 3, "text": "総っ" }, { "id": 4, "text": "深っ" }], "correctAnswer": 1, "explanation": null, "needsReview": false },
        { "id": 13, "mondai": 3, "type": "VOCABULARY", "question": "近所のスーパーで、日用（ ）を買った。", "choices": [{ "id": 1, "text": "物" }, { "id": 2, "text": "品" }, { "id": 3, "text": "貨" }, { "id": 4, "text": "荷" }], "correctAnswer": 2, "explanation": null, "needsReview": false },
        { "id": 14, "mondai": 3, "type": "VOCABULARY", "question": "気温が上がって花も咲きはじめ、だいぶ春（ ）なりました。", "choices": [{ "id": 1, "text": "ように" }, { "id": 2, "text": "こんで" }, { "id": 3, "text": "らしく" }, { "id": 4, "text": "そうに" }], "correctAnswer": 3, "explanation": null, "needsReview": false },
        { "id": 15, "mondai": 3, "type": "VOCABULARY", "question": "コンサートが中止になったため、料金が払い（ ）れた。", "choices": [{ "id": 1, "text": "返さ" }, { "id": 2, "text": "過ごさ" }, { "id": 3, "text": "元さ" }, { "id": 4, "text": "戻さ" }], "correctAnswer": 4, "explanation": null, "needsReview": false },
        { "id": 16, "mondai": 4, "type": "VOCABULARY", "question": "その絵は後の時代の画家に大きな（ ）をおよぼした。", "choices": [{ "id": 1, "text": "影響" }, { "id": 2, "text": "反映" }, { "id": 3, "text": "貢献" }, { "id": 4, "text": "関連" }], "correctAnswer": 1, "explanation": null, "needsReview": false },
        { "id": 17, "mondai": 4, "type": "VOCABULARY", "question": "引越しが近づいたので、かたづけやいろいろな手続きで（ ）毎日です。", "choices": [{ "id": 1, "text": "あわただしい" }, { "id": 2, "text": "うらやましい" }, { "id": 3, "text": "くやしい" }, { "id": 4, "text": "はげしい" }], "correctAnswer": 1, "explanation": null, "needsReview": false },
        { "id": 18, "mondai": 4, "type": "VOCABULARY", "question": "コンピューターを使って、国内だけでなく海外とも（ ）が可能になった。", "choices": [{ "id": 1, "text": "通知" }, { "id": 2, "text": "通信" }, { "id": 3, "text": "通行" }, { "id": 4, "text": "通用" }], "correctAnswer": 2, "explanation": null, "needsReview": false },
        { "id": 19, "mondai": 4, "type": "VOCABULARY", "question": "急な用事ができて、私は子供を友人の家に（ ）ことにした。", "choices": [{ "id": 1, "text": "あずかる" }, { "id": 2, "text": "あずける" }, { "id": 3, "text": "うけとる" }, { "id": 4, "text": "あたえる" }], "correctAnswer": 2, "explanation": null, "needsReview": false },
        { "id": 20, "mondai": 4, "type": "VOCABULARY", "question": "今日は友達の結婚式でスピーチをするので、とても（ ）している。", "choices": [{ "id": 1, "text": "拡張" }, { "id": 2, "text": "出張" }, { "id": 3, "text": "緊張" }, { "id": 4, "text": "主張" }], "correctAnswer": 3, "explanation": null, "needsReview": false },
        { "id": 21, "mondai": 4, "type": "VOCABULARY", "question": "母からの小包には、いろいろな缶詰が（ ）つまっていた。", "choices": [{ "id": 1, "text": "がっかり" }, { "id": 2, "text": "ぎっしり" }, { "id": 3, "text": "ぐっすり" }, { "id": 4, "text": "ばったり" }], "correctAnswer": 2, "explanation": null, "needsReview": false },
        { "id": 22, "mondai": 4, "type": "VOCABULARY", "question": "彼の説明はいつも長くて（ ）ので、いらいらする。", "choices": [{ "id": 1, "text": "えらい" }, { "id": 2, "text": "くどい" }, { "id": 3, "text": "かゆい" }, { "id": 4, "text": "ゆるい" }], "correctAnswer": 2, "explanation": null, "needsReview": false },
        { "id": 23, "mondai": 5, "type": "SYNONYM", "question": "彼は、仕事に力を注いだ。", "target": "力を注いだ", "choices": [{ "id": 1, "text": "集中した" }, { "id": 2, "text": "失った" }, { "id": 3, "text": "抜いた" }, { "id": 4, "text": "貸した" }], "correctAnswer": 1, "explanation": null, "needsReview": false },
        { "id": 24, "mondai": 5, "type": "SYNONYM", "question": "今日は、とてもさわやかな朝だ。", "target": "さわやかな", "choices": [{ "id": 1, "text": "寒い" }, { "id": 2, "text": "気持ちいい" }, { "id": 3, "text": "暑い" }, { "id": 4, "text": "忙しい" }], "correctAnswer": 2, "explanation": null, "needsReview": false },
        { "id": 25, "mondai": 5, "type": "SYNONYM", "question": "薬を使用する場合の目安を教えてください。", "target": "目安", "choices": [{ "id": 1, "text": "目的" }, { "id": 2, "text": "見当" }, { "id": 3, "text": "注意" }, { "id": 4, "text": "方法" }], "correctAnswer": 2, "explanation": null, "needsReview": false },
        { "id": 26, "mondai": 5, "type": "SYNONYM", "question": "父とけんかしてしまい、それから話すきっかけがなかなかつかめない。", "target": "きっかけ", "choices": [{ "id": 1, "text": "機会" }, { "id": 2, "text": "理由" }, { "id": 3, "text": "時間" }, { "id": 4, "text": "場所" }], "correctAnswer": 1, "explanation": null, "needsReview": false },
        { "id": 27, "mondai": 5, "type": "SYNONYM", "question": "教室はとてもさわがしい。", "target": "さわがしい", "choices": [{ "id": 1, "text": "美しい" }, { "id": 2, "text": "むしあつい" }, { "id": 3, "text": "うるさい" }, { "id": 4, "text": "きたない" }], "correctAnswer": 3, "explanation": null, "needsReview": false },
        { "id": 28, "mondai": 6, "type": "WORD_USAGE", "question": "上達", "choices": [{ "id": 1, "text": "その国はまだ上達の段階にあると言えるだろう。" }, { "id": 2, "text": "この料理、初めてにしては上達にできているよ。" }, { "id": 3, "text": "才能がある人は何でも上達が早いものだ。" }, { "id": 4, "text": "社員が社長に仕事の状況を上達するのは常識ですよ。" }], "correctAnswer": 3, "explanation": null, "needsReview": false },
        { "id": 29, "mondai": 6, "type": "WORD_USAGE", "question": "確認", "choices": [{ "id": 1, "text": "出かけるときには戸締りを確認してください。" }, { "id": 2, "text": "あのチームが優勝するのはおそらく確認だ。" }, { "id": 3, "text": "この部屋に事務局の確認なく、入ることを禁止する。" }, { "id": 4, "text": "立候補者が1人だったため無投票で確認された。" }], "correctAnswer": 1, "explanation": null, "needsReview": false },
        { "id": 30, "mondai": 6, "type": "WORD_USAGE", "question": "やけど", "choices": [{ "id": 1, "text": "彼は彼女にふられてから、やけどになっている。" }, { "id": 2, "text": "その火事のために、彼女は大きなやけどをした。" }, { "id": 3, "text": "甘いものを食べすぎて、胸がやけどしている。" }, { "id": 4, "text": "高層ビルから見える東京のやけどがとても美しかった。" }], "correctAnswer": 2, "explanation": null, "needsReview": false },
        { "id": 31, "mondai": 6, "type": "WORD_USAGE", "question": "すらすら", "choices": [{ "id": 1, "text": "その子は、難しい計算問題をすらすらと解いた。" }, { "id": 2, "text": "そんなすらすらなところを通るのは危ないよ。" }, { "id": 3, "text": "シャワーを浴びて、とてもすらすらした。" }, { "id": 4, "text": "すらすら遊ぶのもいいかげんにしなさい。" }], "correctAnswer": 1, "explanation": null, "needsReview": false },
        { "id": 32, "mondai": 6, "type": "WORD_USAGE", "question": "緊張", "choices": [{ "id": 1, "text": "部長はとても、厳しく、緊張な人だ。" }, { "id": 2, "text": "試験の前日は、緊張して眠れなかった。" }, { "id": 3, "text": "緊張な場面では、きちんとあいさつしましょう。" }, { "id": 4, "text": "資料に間違いがあって緊張に謝った。" }], "correctAnswer": 2, "explanation": null, "needsReview": false }
      ]
